{
    "name": "md-to-bbcode",
    "displayName": "Markdown to BBCode",
    "description": "将选中的 Markdown 文本转换为 Steam BBCode 格式",
    "version": "0.0.1",
    "publisher": "k-r-o-s",
    "repository": {
        "type": "git",
        "url": "https://github.com/k-r-o-s/md-to-bbcode.git"
    },
    "engines": {
        "vscode": "^1.74.0"
    },
    "categories": [
        "Other"
    ],
    "contributes": {
        "commands": [
            {
                "command": "mdToBbcode.help",
                "title": "查看 steam 的 BBCode 语法帮助",
                "category": "MD2BBCode"
            },
            {
                "command": "mdToBbcode.convert",
                "title": "Markdown 转 BBCode",
                "category": "MD2BBCode"
            },
            {
                "command": "mdToBbcode.bbCodeToJsonLiteral",
                "title": "BBCode 内容转换并复制为 JSON 字面量",
                "category": "MD2BBCode"
            }
        ],
        "keybindings": []
    },
    "activationEvents": [],
    "main": "extension.js",
    "scripts": {
        "build": "node scripts/build-vsix.js"
    },
    "keywords": [
        "markdown",
        "bbcode",
        "steam",
        "vscode"
    ],
    "author": "k-r-o-s",
    "license": "MIT",
    "type": "commonjs"
}